#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/*
 * Per-half matrix: 5 rows x 6 cols.
 * Rows 0-3: 6 keys each. Row 4: four thumbs + inner key.
 * Left half cols (outer -> inner): 0..5   Right half cols (inner -> outer): 6..11
 */
/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &default_layout;
    };


    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Lily58";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys
            = <&key_physical_attrs 100 100 0 40 0 0 0>,
            <&key_physical_attrs 100 100 100 40 0 0 0>,
            <&key_physical_attrs 100 100 200 10 0 0 0>,
            <&key_physical_attrs 100 100 300 0 0 0 0>,
            <&key_physical_attrs 100 100 400 10 0 0 0>,
            <&key_physical_attrs 100 100 500 25 0 0 0>,
            <&key_physical_attrs 100 100 900 25 0 0 0>,
            <&key_physical_attrs 100 100 1000 10 0 0 0>,
            <&key_physical_attrs 100 100 1100 0 0 0 0>,
            <&key_physical_attrs 100 100 1200 10 0 0 0>,
            <&key_physical_attrs 100 100 1300 40 0 0 0>,
            <&key_physical_attrs 100 100 1400 40 0 0 0>,
            <&key_physical_attrs 100 100 0 140 0 0 0>,
            <&key_physical_attrs 100 100 100 140 0 0 0>,
            <&key_physical_attrs 100 100 200 110 0 0 0>,
            <&key_physical_attrs 100 100 300 100 0 0 0>,
            <&key_physical_attrs 100 100 400 110 0 0 0>,
            <&key_physical_attrs 100 100 500 125 0 0 0>,
            <&key_physical_attrs 100 100 900 125 0 0 0>,
            <&key_physical_attrs 100 100 1000 110 0 0 0>,
            <&key_physical_attrs 100 100 1100 100 0 0 0>,
            <&key_physical_attrs 100 100 1200 110 0 0 0>,
            <&key_physical_attrs 100 100 1300 140 0 0 0>,
            <&key_physical_attrs 100 100 1400 140 0 0 0>,
            <&key_physical_attrs 100 100 0 240 0 0 0>,
            <&key_physical_attrs 100 100 100 240 0 0 0>,
            <&key_physical_attrs 100 100 200 210 0 0 0>,
            <&key_physical_attrs 100 100 300 200 0 0 0>,
            <&key_physical_attrs 100 100 400 210 0 0 0>,
            <&key_physical_attrs 100 100 500 225 0 0 0>,
            <&key_physical_attrs 100 100 900 225 0 0 0>,
            <&key_physical_attrs 100 100 1000 210 0 0 0>,
            <&key_physical_attrs 100 100 1100 200 0 0 0>,
            <&key_physical_attrs 100 100 1200 210 0 0 0>,
            <&key_physical_attrs 100 100 1300 240 0 0 0>,
            <&key_physical_attrs 100 100 1400 240 0 0 0>,
            <&key_physical_attrs 100 100 0 340 0 0 0>,
            <&key_physical_attrs 100 100 100 340 0 0 0>,
            <&key_physical_attrs 100 100 200 310 0 0 0>,
            <&key_physical_attrs 100 100 300 300 0 0 0>,
            <&key_physical_attrs 100 100 400 310 0 0 0>,
            <&key_physical_attrs 100 100 500 325 0 0 0>,
            <&key_physical_attrs 100 100 600 265 0 0 0>,
            <&key_physical_attrs 100 100 800 265 0 0 0>,
            <&key_physical_attrs 100 100 900 325 0 0 0>,
            <&key_physical_attrs 100 100 1000 310 0 0 0>,
            <&key_physical_attrs 100 100 1100 300 0 0 0>,
            <&key_physical_attrs 100 100 1200 310 0 0 0>,
            <&key_physical_attrs 100 100 1300 340 0 0 0>,
            <&key_physical_attrs 100 100 1400 340 0 0 0>,
            <&key_physical_attrs 100 100 250 420 0 0 0>,
            <&key_physical_attrs 100 100 350 420 0 0 0>,
            <&key_physical_attrs 100 100 450 420 0 0 0>,
            <&key_physical_attrs 100 100 560 440 3000 560 440>,
            <&key_physical_attrs 100 100 840 440 (-3000) 840 440>,
            <&key_physical_attrs 100 100 950 420 0 0 0>,
            <&key_physical_attrs 100 100 1050 420 0 0 0>,
            <&key_physical_attrs 100 100 1150 420 0 0 0>
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                 RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                 RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                 RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(4,5) RC(4,6) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
                RC(4,1) RC(4,2) RC(4,3) RC(4,4)                 RC(4,7) RC(4,8) RC(4,9) RC(4,10)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";   /* diode stripe toward the ROW (blue) wire */

        row-gpios
            = <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row 0 numbers */
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row 1 QWERT */
            , <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row 2 ASDFG */
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row 3 ZXCVB */
            , <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row 4 thumbs + inner key */
            ;
    };
};
